# Sao chép file này thành .env rồi điền API key thật:  cp .env.example .env
GEMINI_API_KEY=thay_bang_api_key_cua_ban
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=2

# Semantic Router: local = chỉ dùng embedding + từ khoá (nhanh nhất, câu mơ hồ thì
# hỏi lại), auto = local trước rồi nhờ Gemini phân giải, gemini = luôn gọi Gemini.
ROUTER_MODE=auto
ROUTER_MARGIN=0.03

# ---- Dự phòng FPT Cloud khi Gemini hỏng/hết quota ---------------------------
# Một API key dùng chung cho cả LLM, STT và TTS. Bỏ trống FPT_API_KEY = tắt hết
# dự phòng (lỗi Gemini nổi lên như cũ). Mỗi dịch vụ có công tắc riêng:
#   auto = Gemini trước, hỏng mới sang FPT | gemini = chỉ Gemini | fpt = chỉ FPT
FPT_API_KEY=

# LLM dự phòng (gpt-oss-120b): dùng cho Semantic Router + sinh lời kể.
LLM_PROVIDER=auto
FPT_LLM_URL=https://mkp-api.fptcloud.com/v1/chat/completions
FPT_LLM_MODEL=gpt-oss-120b
FPT_LLM_MAX_RETRIES=1
FPT_LLM_TIMEOUT=90

# STT dự phòng (FPT.AI-whisper-large-v3-turbo). Endpoint chỉ nhận wav/mp3 nên
# bản ghi webm/mp4 của trình duyệt được backend giải mã sang WAV trước khi gửi.
STT_PROVIDER=auto
FPT_STT_URL=https://mkp-api.fptcloud.com/v1/audio/transcriptions
FPT_STT_MODEL=FPT.AI-whisper-large-v3-turbo
FPT_STT_LANGUAGE=vi

# TTS dự phòng (FPT.AI-VITs) — hiện đang ép fpt vì nhanh hơn Gemini TTS ~10 lần.
TTS_PROVIDER=auto
FPT_TTS_URL=https://mkp-api.fptcloud.com/v1/audio/speech
FPT_TTS_MODEL=FPT.AI-VITs
FPT_TTS_VOICE=std_leminh
FPT_TTS_FORMAT=mp3

RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RAG_EMBEDDING_DEVICE=cuda
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.15

# Cấu hình CORS (Các domain phân cách nhau bằng dấu phẩy, dùng * để cho phép tất cả)
CORS_ORIGINS=*
